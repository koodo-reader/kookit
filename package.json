{
  "name": "kookit",
  "version": "1.0.4",
  "description": "Ebook render for mobi, azw3, txt and more",
  "homepage": "https://github.com/troyeguo/koodo-render",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troyeguo/koodo-render.git"
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "npm",
    "package",
    "boilerplate"
  ],
  "main": "dist/kookit.cjs.js",
  "module": "dist/kookit.esm.js",
  "browser": "dist/kookit.umd.js",
  "minify": "dist/kookit.min.js",
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "prebuild:types": "rimraf ./build",
    "build:types": "tsc -p ./tsconfig.json --outDir build --declaration true && api-extractor run",
    "predocs": "rimraf ./docs",
    "docs": "typedoc src --out docs",
    "clean": "rimraf ./build ./dist ./docs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@microsoft/api-extractor": "^7.18.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^20.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^13.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^8.2.5",
    "@types/jszip": "^3.4.1",
    "@types/node": "^16.11.2",
    "@types/rangy": "^0.0.38",
    "core-js": "^3.41.0",
    "eslint": "^7.32.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.56.3",
    "rollup-plugin-commonjs": "^10.1.0",
    "ts-node": "^10.2.1",
    "tslib": "^2.3.1",
    "typedoc": "^0.21.9",
    "typescript": "^4.4.2"
  },
  "dependencies": {
    "7z-wasm": "^1.1.0",
    "chardet": "^2.0.0",
    "chinese-s2t": "^1.0.0",
    "fflate": "^0.8.2",
    "js-untar": "^2.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^15.0.3",
    "mhtml2html": "^3.0.0",
    "rangy": "1.3.0",
    "underscore": "^1.13.7"
  },
  "bugs": {
    "url": "https://github.com/troyeguo/koodo-render/issues"
  },
  "directories": {
    "doc": "docs"
  }
}
